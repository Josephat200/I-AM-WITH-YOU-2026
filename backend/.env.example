# IKODI Backend Environment Configuration

# Server Port (Railway will automatically set this)
PORT=5000

# PostgreSQL Connection String (Supabase Connection Pooler URL)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# JWT Secret for Session & Authentication Tokens
JWT_SECRET=replace-with-a-long-random-production-secret

# Allowed Frontend Origins (CORS)
FRONTEND_URL=https://your-frontend-site.netlify.app

# Optional Supabase Storage (when set, uploads are stored remotely)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=uploads
